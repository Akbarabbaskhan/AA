# Volt — copy to .env and fill in. Every key present, every value blank.
#
# The whole app runs and demos locally with only DATABASE_URL and REDIS_URL set:
# every integration sits behind an interface whose mock implementation is selected
# automatically when its key is absent. See lib/notifications/ and lib/storage/.

# Core
DATABASE_URL=
REDIS_URL=
NEXTAUTH_SECRET=
NEXTAUTH_URL=
APP_URL=
NODE_ENV=

# Storage (S3-compatible — Cloudflare R2 or Wasabi)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# WhatsApp Business Cloud API
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# SMS (local Pakistani aggregator)
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=

# Email
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM=

# Payments (M4+)
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=

# Observability
SENTRY_DSN=
LOG_LEVEL=info

# Web push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Feature flags / tenancy
DEFAULT_TENANT_SLUG=lgs
ENABLE_ONLINE_PAYMENTS=false
ENABLE_SOCIETIES=true
ENABLE_FEE_GATE=false
